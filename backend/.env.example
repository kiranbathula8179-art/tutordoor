# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-64-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database ---
POSTGRES_DB=tutordoor
POSTGRES_USER=tutordoor
POSTGRES_PASSWORD=tutordoor
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Or set a single DSN instead of the individual vars above:
# DATABASE_URL=postgres://tutordoor:tutordoor@postgres:5432/tutordoor

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TutorDoor <no-reply@tutordoor.com>

# --- Google OAuth / Maps ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Stripe ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twilio (SMS / WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# --- Firebase Cloud Messaging (push notifications) ---
FCM_SERVER_KEY=

# --- OTP / verification ---
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=48

# --- Business rules ---
PLATFORM_COMMISSION_PERCENT=15.0
REFERRAL_BONUS_AMOUNT=200.0

# --- Sentry (production only) ---
SENTRY_DSN=

# --- AWS S3 (production media storage) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
