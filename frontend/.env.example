# Base URL of the Django REST API (include /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Base URL for websocket connections (chat)
VITE_WS_BASE_URL=ws://localhost:8000

# Google Sign-In client ID (must match backend GOOGLE_OAUTH_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Razorpay publishable key ID (matches backend RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=

# Stripe publishable key (matches backend STRIPE_PUBLIC_KEY)
VITE_STRIPE_PUBLIC_KEY=

# Google Maps JavaScript API key, for tutor location display
VITE_GOOGLE_MAPS_API_KEY=
